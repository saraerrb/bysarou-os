{
  "name": "bysarou-monorepo",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "pnpm --parallel --recursive run dev",
    "dev:admin": "pnpm --filter bysarou-admin dev",
    "dev:storefront": "pnpm --filter bysarou-storefront dev",
    "dev:api": "pnpm --filter bysarou-api dev"
  }
}
